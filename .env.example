# Telegram: mantenha valores reais somente no arquivo .env local.
TELEGRAM_TOKEN=
TELEGRAM_CANAL=
TG_API_ID=
TG_API_HASH=
TG_CHATS=
TG_MEDIA_CHATS=

# Canais especiais: preserva texto/formatação e troca somente o link do produto.
# Prefira ID numérico estável, por exemplo: -1003781163851
TG_ESPELHO_CHATS=

# Canais cuja imagem precisa ter branding/preço visual da origem cobertos.
# Configure somente após confirmar o ID com: py monitor_ofertas.py --listar
TG_REBRAND_CHATS=
# Ajustes proporcionais opcionais para o layout visual da origem.
TG_REBRAND_TOP_RATIO=0.19
TG_REBRAND_PRICE_BOX=0.64,0.77,0.98,0.95

# Recuperação após reinício
TG_RECUPERAR_MINUTOS=30
TG_RECUPERAR_MAX_MENSAGENS=500
INTERVALO_RECUPERADAS=30
IDADE_MAXIMA_RECUPERADAS_MINUTOS=45

EXIGIR_IMAGEM=1
# Compatibilidade/fluxos legados; o radar integrado usa relógio próprio de 1200 s.
INTERVALO_PUBLICACOES=30
IDADE_MAXIMA_MINUTOS=120

# API de Afiliados Shopee
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_SUB_ID=telegram

# Mercado Livre: OAuth e ferramentas de desenvolvimento
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=
ML_TEST_ITEM_ID=
ML_SITE_ID=MLB
ML_ITEM_IDS=
ML_SELLER_IDS=
ML_MIN_DESCONTO=5
ML_MAX_PUBLICACOES_CICLO=3
ML_INTERVALO_RADAR=900
ML_LIMITE_VENDEDOR=50
ML_REPUBLICAR_QUEDA_PCT=5
ML_MODO_TESTE=1

# Configurações de versões/radar ML
ML_QUERIES=
ML_PRECO_MIN=0
ML_PRECO_MAX=100000
ML_LIMITE_BUSCA=20
ML_SOMENTE_NOVOS=1
ML_MAX_FILHOS_POR_PRODUTO=10

# Banner próprio de cupons Shopee
CUPONS_BANNER=assets/banner_cupons.png

# Grupo autorizado para entrada manual ML; vazio desativa.
ML_MANUAL_CHAT=-1003988174916

# Destino no texto dos alertas de cupons Mercado Livre.
ML_CUPONS_SOCIAL_URL=https://www.mercadolivre.com.br/social/bebidastaio

# Afiliados Mercado Livre via sessão do Link Builder.
# NUNCA publique valores reais; mantenha apenas no .env local.
ML_AFFILIATE_COOKIE=
ML_AFFILIATE_CSRF=
ML_AFFILIATE_TAG=
ML_AFFILIATE_REFRESH_COOKIES=1
ML_AFFILIATE_USER_AGENT=

# KaBuM via Awin Product Data Feed.
# KABUM_AWIN_FEED_URL é privada.
KABUM_AWIN_FEED_URL=
