[Unit]
Description=Radar de Ofertas - Publicador Telegram
After=network-online.target radar-monitor.service
Wants=network-online.target

[Service]
Type=simple
User=radar
Group=radar
WorkingDirectory=/opt/radar
ExecStart=/opt/radar/.venv/bin/python -u /opt/radar/bot_ofertas_revisao.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
