[Unit]
Description=Radar de Ofertas - Monitor Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radar
Group=radar
WorkingDirectory=/opt/radar
ExecStart=/opt/radar/.venv/bin/python -u /opt/radar/monitor_ofertas.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
UMask=0077

[Install]
WantedBy=multi-user.target
